<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>


<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Vista.CatalogoController"
            prefWidth="375.0" prefHeight="556.0"
            style="-fx-background-color: #D1D1D1;">

    <children>
        <!-- Botón Carrito en la esquina superior derecha -->
        <Button onAction="#abrirCarrito"
                style="-fx-background-color: transparent;"
                layoutX="330.0" layoutY="10.0"
                prefWidth="32.0" prefHeight="32.0">
            <graphic>
                <ImageView fitWidth="32" fitHeight="32">
                    <image>
                        <Image url="@/Imagenes/40368.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Filtro de categorías -->
        <Pane layoutX="14.0" layoutY="53.0" prefWidth="347.0" prefHeight="50.0"
              style="-fx-background-color: #aaaaaa; -fx-border-radius:8; -fx-background-radius:8;">
            <children>
                <HBox spacing="10" layoutX="60.0" layoutY="12.0">
                    <Button fx:id="btnTodos"    onAction="#filtrarTodos"  text="Todos"/>
                    <Button fx:id="btnHombres"  onAction="#filtrarHombres" text="Hombres"/>
                    <Button fx:id="btnMujeres"  onAction="#filtrarMujeres" text="Mujeres"/>
                    <Button fx:id="btnInfantil" onAction="#filtrarInfantil" text="Infantil"/>
                </HBox>
            </children>
        </Pane>

        <!-- Títulos -->
        <Label layoutX="23.0" layoutY="5.0" text="Nuestros">
            <font><Font name="SansSerif Bold" size="14"/></font>
        </Label>
        <Label layoutX="23.0" layoutY="23.0" text="Productos">
            <font><Font name="SansSerif Bold" size="14"/></font>
        </Label>

        <!-- Catálogo de productos -->
        <ScrollPane fx:id="scrollCatalogo"
                    layoutX="15.0" layoutY="110.0"
                    prefWidth="345.0" prefHeight="436.0"
                    AnchorPane.topAnchor="110.0"
                    AnchorPane.bottomAnchor="10.0"
                    AnchorPane.leftAnchor="15.0"
                    AnchorPane.rightAnchor="15.0">
            <content>
                <TilePane fx:id="contenedorProductos"
                          prefWidth="345.0" prefHeight="700.0"
                          hgap="15" vgap="15">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                </TilePane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>